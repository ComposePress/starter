<?xml version="1.0"?>
<ruleset name="ComposePress Starter">
    <description>PSR-12 checks for the ComposePress starter.</description>
    <rule ref="PSR12" />
    <exclude name="PSR1.Files.SideEffects.FoundWithSymbols" />
    <file>src</file>
    <file>tests</file>
    <arg name="basepath" value="." />
    <arg name="colors" />
    <arg name="warning-severity" value="0" />
    <arg name="parallel" value="80" />
    <arg name="report" value="full" />
</ruleset>
